# Folder where HLS lives are written (lives/{stream_id}/index.m3u8), relative to stream/
LIVES_DIR=lives
# How long the "signal lost" screen waits for the streamer before the live ends
RECONNECT_SECONDS=30
# Without any data for this long, the streamer is considered gone
SIGNAL_TIMEOUT_SECONDS=10
# MQTT broker where stream/started and stream/ended are published
MQTT_HOST=localhost
MQTT_PORT=1883
