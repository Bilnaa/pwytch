# PostgreSQL connection URL (SQLAlchemy format, psycopg 3 driver)
# Matches the defaults of the postgres service in docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/microservices

# Secret used to sign the JWT access tokens. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
# Optional, defaults shown
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL of the stream service and how long to wait for it. Defaults shown
# STREAM_URL=http://localhost:8001
# STREAM_TIMEOUT_SECONDS=5

# URL of the search service and how long to wait for it. Defaults shown
# SEARCH_URL=http://localhost:8004
# SEARCH_TIMEOUT_SECONDS=5

# MQTT broker that main listens to. Defaults shown
# MQTT_HOST=localhost
# MQTT_PORT=1883

# Origin of the front allowed to call main from the browser (CORS). Default shown
# FRONTEND_ORIGIN=http://localhost:5173
