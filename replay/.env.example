# replay database created by infra/postgres/init.sql
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/replay
MQTT_HOST=localhost
MQTT_PORT=1883
# LIVES_DIR of stream (lives/{stream_id}/index.m3u8), read only, relative to replay/
LIVES_DIR=../stream/lives
REPLAYS_DIR=replays
CONVERSION_TIMEOUT_S=600
