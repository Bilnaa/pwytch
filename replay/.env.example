# replay database created by infra/postgres/init.sql
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/replay
MQTT_HOST=localhost
MQTT_PORT=1883
# stream serves the HLS playlists and segments, also for ended lives
STREAM_URL=http://localhost:8001
REPLAYS_DIR=replays
STREAM_TIMEOUT_S=5
CONVERSION_TIMEOUT_S=600
