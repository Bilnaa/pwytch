# PostgreSQL connection URL (SQLAlchemy format, psycopg 3 driver)
# Matches the defaults of the postgres service in docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/microservices
# MQTT broker where the bookmark service will connect to + port
MQTT_HOST=localhost
MQTT_PORT=1883
# Redis connection URL, used for the bookmarks cache
REDIS_URL=redis://localhost:6379/0